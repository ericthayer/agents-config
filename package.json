{
  "name": "agents-config",
  "version": "1.6.0",
  "description": "Compatible React entry point for shared AI agent configuration, with Angular and Vue packages available.",
  "author": "Eric Thayer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericthayer/agents-config.git"
  },
  "homepage": "https://github.com/ericthayer/agents-config#readme",
  "bugs": {
    "url": "https://github.com/ericthayer/agents-config/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "copilot",
    "claude",
    "gemini",
    "cursor",
    "react",
    "typescript",
    "accessibility",
    "performance",
    "development-tools",
    "code-generation",
    "agentic-workflows"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@agents-config/core": "1.6.0",
    "@agents-config/react": "1.6.0"
  },
  "bin": {
    "agents-init": "bin/agents-init.js",
    "agents-analyze": "bin/agents-analyze.js"
  },
  "files": [
    ".github/COMMIT_CONVENTION.md",
    ".github/GITHUB_AUTH_SETUP.md",
    ".github/pr-template-commits.md",
    ".github/pr-body-semantic-release.md",
    "AGENTS.md",
    "README.md",
    "bin/",
    "adapters/",
    "instructions/",
    "rules/",
    "skills/",
    "schemas/"
  ],
  "scripts": {
    "postinstall": "node ./bin/postinstall.js",
    "pretest": "node scripts/prepare-packages.js",
    "test": "node --test tests/*.test.js",
    "test:packages": "node scripts/test-packages.js",
    "prepare:packages": "node scripts/prepare-packages.js",
    "prepare": "node scripts/prepare-packages.js",
    "prepack": "node scripts/prepare-packages.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
